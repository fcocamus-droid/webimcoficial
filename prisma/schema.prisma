// prisma/schema.prisma
// IMC Cargo - Cotizador de Flete Internacional
// Powered by Supabase (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===== ENUMS =====

enum Role {
  CLIENT
  EXECUTIVE
  SUPERADMIN
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ShipmentType {
  LCL
  FCL_20
  FCL_40
  FCL_40HC
  AIR
}

enum Incoterm {
  EXW
  FOB
  CFR
  CIF
  DAP
  DDP
}

// ===== MODELS =====

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  company       String?   // legacy free-text company name
  phone         String?
  rut           String?
  role          Role      @default(CLIENT)
  emailVerified DateTime?
  verifyToken   String?
  resetToken    String?
  resetExpires  DateTime?
  companyId     String?
  companyRef    Company?  @relation(fields: [companyId], references: [id])
  // IMC Box fields
  casillaNumber    String?  @unique
  legacyBoxCode    String?  @unique
  boxClientActive  Boolean  @default(false)
  boxNotes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  quotes                Quote[]
  executiveAssignments  ClientAssignment[] @relation("ExecutiveAssignments")
  clientAssignments     ClientAssignment[] @relation("ClientAssignments")
  packages              Package[]
  preAlerts             PreAlert[]
  amazonRequests        AmazonRequest[]

  @@map("users")
}

model Company {
  id                String   @id @default(cuid())
  razonSocial       String
  rut               String   @unique
  giro              String
  direccion         String
  comuna            String
  ciudad            String
  region            String
  telefono          String?
  emailFacturacion  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users     User[]
  documents CompanyDocument[]

  @@map("companies")
}

model CompanyDocument {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type       String   // RUT_EMPRESA | CERTIFICADO_SII | PODER_NOTARIAL
  fileName   String
  fileUrl    String
  fileSize   Int
  uploadedBy String
  createdAt  DateTime @default(now())

  @@map("company_documents")
}

model ClientAssignment {
  id          String   @id @default(cuid())
  executiveId String
  executive   User     @relation("ExecutiveAssignments", fields: [executiveId], references: [id])
  clientId    String
  client      User     @relation("ClientAssignments", fields: [clientId], references: [id])
  assignedAt  DateTime @default(now())

  @@unique([executiveId, clientId])
  @@map("client_assignments")
}

model Quote {
  id     String @id @default(cuid())
  number String @unique // QTE-2025-0001

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Shipment details
  shipmentType ShipmentType
  incoterm     Incoterm
  originPort   String
  destPort     String
  commodity    String
  hsCode       String?

  // LCL
  cbm      Float?
  weightKg Float?

  // FCL
  containerQty Int?

  // Air
  chargeableKg Float?

  // Cargo value
  cargoValueUSD Float?

  // Calculated costs (USD)
  freightCost   Float
  originCost    Float
  destCost      Float
  customsCost   Float?
  insuranceCost Float?
  totalCostUSD  Float
  totalCostCLP  Float?

  // Exchange rate used at quote time
  usdClpRate Float?

  // Metadata
  status     QuoteStatus @default(DRAFT)
  validUntil DateTime
  notes      String?
  pdfUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items QuoteItem[]

  @@map("quotes")
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  cost        Float
  currency    String @default("USD")
  // FREIGHT | ORIGIN | DESTINATION | CUSTOMS | INSURANCE | SURCHARGE | LAST_MILE
  type        String

  @@map("quote_items")
}

model Carrier {
  id     String @id @default(cuid())
  name   String
  code   String @unique // MSC, CMA, HAPAG, LATAM
  // MARITIME | AIR | MULTIMODAL
  type   String
  active Boolean @default(true)

  rates ShippingRate[]

  @@map("carriers")
}

model ShippingRate {
  id         String   @id @default(cuid())
  carrierId  String
  carrier    Carrier  @relation(fields: [carrierId], references: [id])
  originPort String
  destPort   String
  shipmentType ShipmentType

  // LCL (W/M logic: max of CBM vs ton)
  ratePerCBM Float?
  ratePerTon Float?
  minCBM     Float? @default(1)

  // FCL
  rateContainer Float?

  // Air
  ratePerKg Float?
  minKg     Float?

  currency  String   @default("USD")
  validFrom DateTime
  validTo   DateTime
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shipping_rates")
}

model Surcharge {
  id           String       @id @default(cuid())
  name         String
  code         String       @unique // BAF, CAF, THC, ISPS, IMO, PSS
  description  String?
  amount       Float
  currency     String       @default("USD")
  shipmentType ShipmentType? // null = all types
  portCode     String?       // null = all ports
  active       Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("surcharges")
}

model Port {
  id      String  @id @default(cuid())
  name    String
  code    String  @unique // CLVAP, CLSAI, CNSHA, USLAX
  country String
  // SEA | AIR
  type    String
  active  Boolean @default(true)

  @@map("ports")
}

model ExchangeRate {
  id       String   @id @default(cuid())
  usdToCLP Float
  date     DateTime @default(now())

  @@map("exchange_rates")
}

model LastMileZone {
  id          String  @id @default(cuid())
  region      String  // RM, V, VIII, etc.
  description String
  rateUSD     Float
  active      Boolean @default(true)

  @@map("last_mile_zones")
}

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_config")
}

// ===== IMC BOX MODELS =====

model PackageType {
  id              String  @id @default(cuid())
  name            String  @unique
  slug            String  @unique
  description     String?
  daiRate         Float   @default(0.06)
  ivaRate         Float   @default(0.19)
  requiresPermit  Boolean @default(false)
  permitAuthority String?
  active          Boolean @default(true)
  createdAt       DateTime @default(now())

  packages  Package[]
  preAlerts PreAlert[]

  @@map("package_types")
}

model PreAlert {
  id              String   @id @default(cuid())
  code            String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store           String?
  tracking        String?
  description     String
  valueUSD        Float
  estimatedWeight Float?
  packageTypeId   String?
  packageType     PackageType? @relation(fields: [packageTypeId], references: [id])
  invoiceUrl      String?
  status          String   @default("PENDING")
  // PENDING | RECEIVED | DISCREPANCY | CANCELLED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("pre_alerts")
}

model Package {
  id              String   @id @default(cuid())
  code            String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  preAlertId      String?
  description     String
  tracking        String?
  whr             String?
  costUSD         Float?
  weightLbs       Float?
  weightKg        Float?
  lengthCm        Float?
  widthCm         Float?
  heightCm        Float?
  volumetricKg    Float?
  billableKg      Float?
  packageTypeId   String?
  packageType     PackageType? @relation(fields: [packageTypeId], references: [id])
  photoUrls       Json     @default("[]")
  status          String   @default("RECEIVED_MIAMI")
  // RECEIVED_MIAMI | IN_SHIPMENT | IN_TRANSIT | IN_CUSTOMS | CLEARED | OUT_FOR_DELIVERY | DELIVERED
  shipmentId      String?
  shipment        BoxShipment? @relation(fields: [shipmentId], references: [id])
  notes           String?
  isUsed          Boolean  @default(false)
  isAmazon        Boolean  @default(false)
  buyByMeRequest  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events PackageEvent[]
  amazonRequests AmazonRequest[]

  @@index([userId])
  @@index([status])
  @@index([shipmentId])
  @@map("packages")
}

model BoxShipment {
  id            String   @id @default(cuid())
  code          String   @unique
  type          String   @default("AIR")
  status        String   @default("DRAFT")
  // DRAFT | LOADING | IN_TRANSIT | IN_CUSTOMS | CLEARED | DELIVERED | CLOSED
  departureDate DateTime?
  arrivalDate   DateTime?
  originPort    String   @default("KMIA")
  destPort      String   @default("SCL")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  packages Package[]

  @@map("box_shipments")
}

model BoxRate {
  id             String  @id @default(cuid())
  minKg          Float
  maxKg          Float?
  ratePerKg      Float
  minimumCharge  Float?
  shipmentType   String  @default("AIR")
  isAmazon       Boolean @default(false)
  isUsed         Boolean @default(false)
  active         Boolean @default(true)
  createdAt      DateTime @default(now())

  @@map("box_rates")
}

model BoxFactor {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Float
  description String?
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@map("box_factors")
}

model AmazonRequest {
  id             String  @id @default(cuid())
  code           String  @unique
  userId         String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productUrl     String?
  description    String
  valueUSD       Float
  quantity       Int     @default(1)
  marginPercent  Float   @default(0.10)
  tracking       String?
  status         String  @default("REQUESTED")
  // REQUESTED | APPROVED | PURCHASED | RECEIVED_MIAMI | IN_SHIPMENT | DELIVERED | REJECTED
  packageId      String?
  package        Package? @relation(fields: [packageId], references: [id])
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("amazon_requests")
}

model PackageEvent {
  id          String   @id @default(cuid())
  packageId   String
  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  status      String
  description String?
  location    String?
  userId      String?
  createdAt   DateTime @default(now())

  @@index([packageId])
  @@map("package_events")
}

model ContactMessage {
  id         String   @id @default(cuid())
  source     String
  // IMCBOX | IMCCARGO | IMPORTADORA
  name       String
  email      String
  phone      String?
  subject    String?
  message    String
  status     String   @default("NEW")
  assignedTo String?
  createdAt  DateTime @default(now())

  @@index([status])
  @@map("contact_messages")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}
